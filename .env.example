# OpenAI-compatible provider configuration. Do not commit real credentials.
TENDERAI_LLM_PROVIDER=openai_compatible
TENDERAI_LLM_BASE_URL=http://localhost:11434/v1
TENDERAI_LLM_API_KEY=
TENDERAI_LLM_MODEL=gpt-4o-mini
TENDERAI_LLM_TIMEOUT_SECONDS=60
TENDERAI_LLM_MAX_RETRIES=2
TENDERAI_LLM_TEMPERATURE=0
TENDERAI_ANALYSIS_CHUNK_MAX_CHARS=12000
TENDERAI_ANALYSIS_CHUNK_OVERLAP_CHARS=1000

# Persistent application data. The data directory and SQLite files are ignored by Git.
TENDERAI_DATABASE_URL=sqlite:///./data/tenderai.db
